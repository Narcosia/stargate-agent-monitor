{
  "_comment": [
    "Merge the 'hooks' block below into ~/.claude/settings.json, or just run",
    "./install-hooks.sh which does it for you. Device address is 192.168.1.200.",
    "",
    "The Subagent*/Task* events let the ring distinguish 'waiting on you' from",
    "'waiting on its own background agents'. Without them a session that spawns",
    "agents and goes quiet looks idle, and the ring cries wolf.",
    "",
    "timeout is short on purpose. HTTP hooks default to 600s, and Stop and",
    "UserPromptSubmit are awaited - if the ring were off, a long timeout would",
    "stall every turn. The background-work events use 2s because they fire far",
    "more often."
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.1.200/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.1.200/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.1.200/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.1.200/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.1.200/hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.1.200/hook",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.1.200/hook",
            "timeout": 2
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.1.200/hook",
            "timeout": 2
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://192.168.1.200/hook",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
